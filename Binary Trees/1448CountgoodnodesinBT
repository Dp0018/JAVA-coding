class Solution {

    public int goodNodes(TreeNode root) {
        return dfs(root, root.val);
    }

    private int dfs(TreeNode root, int maxValue) {

        if (root == null) {
            return 0;
        }

        int count = 0;

        // Is current node good?
        if (root.val >= maxValue) {
            count = 1;
        }

        // Update maximum value on this path
        maxValue = Math.max(maxValue, root.val);

        // Search left and right
        count += dfs(root.left, maxValue);
        count += dfs(root.right, maxValue);

        return count;
    }
}
//"I use DFS and keep track of the maximum value encountered on the path from the root to the current node.
//For each node, if its value is greater than or equal to this maximum, it is a good node.
//I count it, update the maximum, and recursively visit the left and right children."

//Time:  O(n) where n is the number of nodes in the tree
//Space: O(h) where h is the height of the tree