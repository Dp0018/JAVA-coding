//graph.get(node) Give me all the neighbors of this node.
import java.util.*;

public class Graph {

    public static void dfs(
        List<List<Integer>> graph,
        int node,
        boolean[] visited
    ) {

        // Mark current node as visited
        visited[node] = true;

        // Process current node
        System.out.print(node + " ");

        // Visit all neighbors
        for (int neighbor : graph.get(node)) {

            if (!visited[neighbor]) {

                dfs(graph, neighbor, visited);
            }
        }
    }

    public static void main(String[] args) {

        int n = 5;

        int[][] edges = {
            {0, 1},
            {0, 2},
            {1, 3},
            {1, 4}
        };

        // Create adjacency list
        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }

        // Undirected graph
        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            graph.get(u).add(v);
            graph.get(v).add(u);
        }

        // Visited array
        boolean[] visited = new boolean[n];

        // DFS starting from node 0
        dfs(graph, 0, visited);
    }
}

Time:  O(V + E)
Space: O(V);