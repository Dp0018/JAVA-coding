import java.util.*;

class Edge {
    int to;
    int weight;

    Edge(int to, int weight) {
        this.to = to;
        this.weight = weight;
    }
}

public class Graph {

    public static void main(String[] args) {

        int n = 4;

        // {source, destination, weight}
        int[][] edges = {
            {0, 1, 5},
            {0, 2, 2},
            {1, 3, 3},
            {2, 3, 4}
        };

        // Create adjacency list
        List<List<Edge>> graph = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }

        // Add edges
        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];
            int weight = edge[2];

            // Undirected graph
            graph.get(u).add(new Edge(v, weight));
            graph.get(v).add(new Edge(u, weight));
        }

        // Print graph
        for (int i = 0; i < n; i++) {

            System.out.print(i + " -> ");

            for (Edge edge : graph.get(i)) {
                System.out.print(
                    "(" + edge.to + ", " + edge.weight + ") "
                );
            }

            System.out.println();
        }
    }
}

