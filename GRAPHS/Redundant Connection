class Solution {

    int[] parent;

    public int[] findRedundantConnection(int[][] edges) {

        int n = edges.length;

        parent = new int[n + 1];

        // Every node is initially its own parent
        for (int i = 1; i <= n; i++) {
            parent[i] = i;
        }

        for (int[] edge : edges) {

            int a = edge[0];
            int b = edge[1];

            // Already connected → cycle
            if (find(a) == find(b)) {
                return edge;
            }

            // Connect the two groups
            union(a, b);
        }

        return new int[]{};
    }

    private int find(int x) {

        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }

        return parent[x];
    }

    private void union(int a, int b) {

        int rootA = find(a);
        int rootB = find(b);

        parent[rootA] = rootB;
    }
}