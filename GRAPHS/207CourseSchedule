//if there is a cycle, you cannot finish all courses.

class Solution {

    public boolean canFinish(int numCourses, int[][] prerequisites) {

        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < numCourses; i++) {
            graph.add(new ArrayList<>());
        }

        for (int[] prerequisite : prerequisites) {

            int course = prerequisite[0];
            int pre = prerequisite[1];

            graph.get(pre).add(course);
        }

        int[] state = new int[numCourses];

        for (int i = 0; i < numCourses; i++) {

            if (hasCycle(graph, i, state)) {
                return false;
            }
        }

        return true;
    }

    private boolean hasCycle(
        List<List<Integer>> graph,
        int course,
        int[] state
    ) {

        if (state[course] == 1) {  // Currently in DFS path → cycle
            return true;
        }

        if (state[course] == 2) {    // Already completely processed
            return false;
        }

        
        // Mark as currently visiting
        state[course] = 1;

        for (int next : graph.get(course)) {

            if (hasCycle(graph, next, state)) {
                return true;
            }
        }
        
        // Completely processed
        state[course] = 2;

        return false;
    }
}


//I model the courses as a directed graph. 
//For each prerequisite [course, prerequisite], I add an edge from the prerequisite to the course. 
//Then I use DFS to detect a cycle. 
//I maintain a state array: 0 means unvisited, 1 means currently in the DFS path, and 2 means completely processed. 
//If I encounter a node with state 1, I've found a cycle, which means the courses cannot all be completed, so I return false. 
//After completely processing a course, I mark it as 2. If no cycle is found, I return true."

//time complexity: O(V + E), where V is the number of courses and E is the number of prerequisites.
//space complexity: O(V + E) for the graph and O(V) for the state array.

//This solution is efficient and works well for the problem of determining if all courses can be finished given the prerequisites.




import java.util.*;

class Solution {

    public boolean canFinish(int numCourses, int[][] prerequisites) {

        // Create graph
        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < numCourses; i++) {
            graph.add(new ArrayList<>());
        }

        // Indegree
        int[] indegree = new int[numCourses];

        // Build graph and calculate indegree
        for (int[] prerequisite : prerequisites) {

            int course = prerequisite[0];
            int pre = prerequisite[1];

            graph.get(pre).add(course);

            indegree[course]++;
        }

        // Queue
        Queue<Integer> queue = new LinkedList<>();

        // Add courses with no prerequisites
        for (int i = 0; i < numCourses; i++) {

            if (indegree[i] == 0) {
                queue.offer(i);
            }
        }

        // Count processed courses
        int count = 0;

        // BFS / Topological Sort
        while (!queue.isEmpty()) {

            int course = queue.poll();

            count++;

            // Remove this course as prerequisite
            for (int next : graph.get(course)) {

                indegree[next]--;

                if (indegree[next] == 0) {
                    queue.offer(next);
                }
            }
        }

        // If all courses were processed,
        // there is no cycle
        return count == numCourses;
    }
}

//"This is a directed graph cycle-detection problem that can be solved using topological sorting.
//I build an adjacency list from each prerequisite to its course and calculate the indegree of every course. 
//I put all courses with indegree zero into a queue and process them using BFS. For each processed course, I decrease the indegree of its neighboring courses.
// When a neighbor reaches zero, I add it to the queue. 
//Finally, if I processed all numCourses, there is no cycle and I return true. Otherwise, a cycle exists and I return false."

