import java.util.*;

class Solution {

    public int[] dijkstra(
        int n,
        List<List<int[]>> graph,
        int source
    ) {

        // Distance from source
        int[] dist = new int[n];

        Arrays.fill(dist, Integer.MAX_VALUE);

        // Source distance = 0
        dist[source] = 0;

        // Min Heap
        PriorityQueue<int[]> pq =
            new PriorityQueue<>(
                (a, b) -> a[1] - b[1]
            );

        // {node, distance}
        pq.offer(new int[]{source, 0});

        while (!pq.isEmpty()) {

            int[] current = pq.poll();

            int node = current[0];                  // oth position node
            int distance = current[1];              //1th position

            // Ignore outdated entry ,This is used because the PriorityQueue can contain old/outdated distances. dist[1] = 10 and later discovered:dist[1] = 5  When [1,5] is processed, dist[1] is 5.Later [1,10] comes out.
            if (distance > dist[node]) {
                continue;
            }

            // Visit neighbors
            for (int[] edge : graph.get(node)) {

                int neighbor = edge[0];
                int weight = edge[1];

                int newDistance =
                    distance + weight;

                // Relaxation
                if (newDistance < dist[neighbor]) {

                    dist[neighbor] = newDistance;

                    pq.offer(
                        new int[]{
                            neighbor,
                            newDistance
                        }
                    );
                }
            }
        }

        return dist;
    }
}



