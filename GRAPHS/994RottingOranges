import java.util.*;

class Solution {

    public int orangesRotting(int[][] grid) {

        int rows = grid.length;
        int cols = grid[0].length;

        Queue<int[]> queue = new LinkedList<>();

        int fresh = 0;

        // Find all rotten and fresh oranges
        for (int row = 0; row < rows; row++) {

            for (int col = 0; col < cols; col++) {

                if (grid[row][col] == 2) {
                    queue.offer(new int[]{row, col});
                }

                else if (grid[row][col] == 1) {
                    fresh++;
                }
            }
        }

        int minutes = 0;

        int[][] directions = {
            {-1, 0},  // up
            {1, 0},   // down
            {0, -1},  // left
            {0, 1}    // right
        };

        // BFS
        while (!queue.isEmpty() && fresh > 0) {

            int size = queue.size();

            for (int i = 0; i < size; i++) {

                int[] current = queue.poll();

                int row = current[0];
                int col = current[1];

                for (int[] direction : directions) {

                    int newRow = row + direction[0];
                    int newCol = col + direction[1];

                    // Check boundaries
                    if (newRow < 0 || newRow >= rows ||
                        newCol < 0 || newCol >= cols) {

                        continue;
                    }

                    // Fresh orange
                    if (grid[newRow][newCol] == 1) {

                        grid[newRow][newCol] = 2;

                        fresh--;

                        queue.offer(new int[]{newRow, newCol});
                    }
                }
            }

            minutes++;
        }

        // If fresh oranges remain, impossible
        if (fresh > 0) {
            return -1;
        }

        return minutes;
    }
}
//time complexity: O(m * n) where m is the number of rows and n is the number of columns in the grid. Each cell is processed at most once.
//space complexity: O(m * n) in the worst case, where all oranges are rotten

//I'll use multi-source BFS because all initially rotten oranges spread simultaneously. 
// First, I put all rotten oranges into a queue and count the number of fresh oranges. 
// Then I process the queue level by level. Each level represents one minute. 
// For every rotten orange, I check its four neighboring cells.
// If a neighbor is fresh, I make it rotten, decrease the fresh count, and add it to the queue. 
// After BFS finishes, if any fresh oranges remain, they cannot be reached, so I return -1. 
// Otherwise, I return the number of minutes."