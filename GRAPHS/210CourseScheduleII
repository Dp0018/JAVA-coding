import java.util.*;

class Solution {

    public int[] findOrder(int numCourses, int[][] prerequisites) {

        // 1. Build adjacency list
        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < numCourses; i++) {
            graph.add(new ArrayList<>());
        }

        // 2. Calculate indegree
        int[] indegree = new int[numCourses];

        for (int[] prerequisite : prerequisites) {

            int course = prerequisite[0];
            int pre = prerequisite[1];

            graph.get(pre).add(course);
            indegree[course]++;
        }

        // 3. Add courses with no prerequisites
        Queue<Integer> queue = new LinkedList<>();

        for (int i = 0; i < numCourses; i++) {

            if (indegree[i] == 0) {
                queue.offer(i);
            }
        }

        // 4. Topological sort
        int[] result = new int[numCourses];
        int index = 0;

        while (!queue.isEmpty()) {

            int course = queue.poll();

            result[index++] = course;

            // Remove this course as a prerequisite
            for (int next : graph.get(course)) {

                indegree[next]--;

                // All prerequisites completed
                if (indegree[next] == 0) {
                    queue.offer(next);
                }
            }
        }

        // 5. If not all courses were processed,
        // there is a cycle
        if (index != numCourses) {
            return new int[0];
        }

        return result;
    }
}

//"I'll use Kahn's Algorithm for topological sorting. 
//I build a directed graph where an edge goes from the prerequisite to the course.
// I maintain an indegree array representing how many prerequisites each course has.
//  I initially put all courses with indegree zero into a queue. 
//  Then I process them using BFS. When I process a course, I reduce the indegree of its dependent courses. 
//  If a dependent course reaches zero, I add it to the queue. 
//  Finally, if I've processed all courses, the result is a valid ordering. Otherwise, a cycle exists, so I return an empty array."

//  Prerequisites
     ↓
//Build Graph
     ↓
//Calculate Indegree
     ↓
//indegree == 0
     ↓
//Queue
     ↓
//BFS
     ↓
//Decrease neighbors' indegree
     ↓
//indegree == 0 → Queue
     ↓
//All courses processed?
   ↙          ↘
// YES           NO
  ↓             ↓
//Answer        Cycle
              → []

//time:  O(V + E)
//space: O(V + E) for the graph representation and O(V) for the indegree