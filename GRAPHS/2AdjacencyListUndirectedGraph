import java.util.*;

public class Graph {

    public static void main(String[] args) {

        int n = 5;

        int[][] edges = {
            {0, 1},
            {0, 2},
            {1, 3},
            {3, 4},
            {2, 4}
        };

        // Create adjacency list
        List<List<Integer>> graph = new ArrayList<>();

        // Create a list for every vertex
        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }

        // Add edges
        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            // Undirected graph
            graph.get(u).add(v);
            graph.get(v).add(u);
        }

        // Print graph
        for (int i = 0; i < n; i++) {
            System.out.println(i + " -> " + graph.get(i));
        }
    }
}