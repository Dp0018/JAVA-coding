class Solution {

    public int minCostConnectPoints(int[][] points) {

        int n = points.length;

        boolean[] visited = new boolean[n];

        int[] minDist = new int[n];               //The cheapest cost currently known to connect point i to the points already included in the MST.

        Arrays.fill(minDist, Integer.MAX_VALUE);

        minDist[0] = 0;                            //starting point.

        int totalCost = 0;                         //This will store the final MST cost.

        for (int count = 0; count < n; count++) {

            int current = -1;                    //current will store which unvisited point should we choose next? , -1 We haven't chosen a point yet.

            for (int i = 0; i < n; i++) {        //Find the cheapest unvisited point
 
                if (!visited[i] &&                //"Among unvisited points, find the one with the smallest connection cost.
                    (current == -1 ||
                     minDist[i] < minDist[current])) {

                    current = i;
                }
            }

            visited[current] = true;

            totalCost += minDist[current];

            for (int next = 0; next < n; next++) {

                if (!visited[next]) {

                    int distance =
                        Math.abs(points[current][0] - points[next][0])
                        +
                        Math.abs(points[current][1] - points[next][1]);

                    minDist[next] =
                        Math.min(minDist[next], distance);
                }
            }
        }

        return totalCost;
    }
}


//"This is a Minimum Spanning Tree problem, so I use Prim's algorithm. 
// Each point is a vertex, and the Manhattan distance between two points is the edge weight. 
// I maintain a visited array and a minDist array. minDist[i] stores the cheapest cost to connect point i to the current MST.
//  In every iteration, I select the unvisited point with the smallest minDist, add its cost to the answer, mark it visited, and update the minimum connection cost for all remaining points."

//Time:  O(N^2) N = number of points
//Space: O(N)


