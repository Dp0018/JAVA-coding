class solution{
    int count = 0;
    int result = 0;
    public int kthSmallest(TreeNode root, int k) {
        inorder(root, k);
        return result;
}

    private void inorder(TreeNode node, int k) {
        if (node == null) {
            return;
        }

        // Traverse the left subtree
        inorder(node.left, k);

        // Increment the count of visited nodes
        count++;

        // If count equals k, we found the kth smallest element
        if (count == k) {
            result = node.val;
            return;
        }

        // Traverse the right subtree
        inorder(node.right, k);
    }
}

//Time: O(h + k) where h is the height of the tree and k is the number of nodes visited until we find the kth smallest element
//Space: O(h) where h is the height of the tree due to recursion stack

//"To find the kth smallest element in a BST, I perform an inorder traversal, which visits nodes in sorted order. I keep a count of the nodes visited, and when the count reaches k, I record the value of that node as the result."
