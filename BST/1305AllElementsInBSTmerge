class Solution {

    public List<Integer> getAllElements(TreeNode root1, TreeNode root2) {

        List<Integer> list1 = new ArrayList<>();
        List<Integer> list2 = new ArrayList<>();

        // Convert both BSTs into sorted lists
        inorder(root1, list1);
        inorder(root2, list2);

        // Merge two sorted lists
        List<Integer> result = new ArrayList<>();

        merge(list1, list2, result);

        return result;
    }

    // Recursive inorder traversal
    private void inorder(TreeNode root, List<Integer> list) {

        if (root == null) {
            return;
        }

        inorder(root.left, list);

        list.add(root.val);

        inorder(root.right, list);
    }

    // Merge two sorted lists
    private void merge(
        List<Integer> list1,
        List<Integer> list2,
        List<Integer> result
    ) {

        int i = 0;
        int j = 0;

        while (i < list1.size() && j < list2.size()) {

            if (list1.get(i) <= list2.get(j)) {
                result.add(list1.get(i));
                i++;
            } else {
                result.add(list2.get(j));
                j++;
            }
        }

        while (i < list1.size()) {
            result.add(list1.get(i));
            i++;
        }

        while (j < list2.size()) {
            result.add(list2.get(j));
            j++;
        }
    }
}

//"I use recursive inorder traversal because inorder traversal of a BST produces elements in sorted order.
//  I generate a sorted list for each tree and then merge the two sorted lists using two pointers, similar to merge sort."
//tc: O(n + m) where n and m are the number of nodes in the two BSTs
//sc: O(n + m) for storing the elements of both BSTs in lists