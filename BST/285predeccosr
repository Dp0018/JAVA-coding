class Solution {

    public TreeNode inorderPredecessor(TreeNode root, TreeNode p) {

        TreeNode predecessor = null;

        while (root != null) {

            if (p.val > root.val) {

                // root can be predecessor
                predecessor = root;

                // Look for a larger value
                root = root.right;

            } else {

                // Predecessor must be on the left
                root = root.left;
            }
        }

        return predecessor;
    }
}
//"The inorder predecessor is the largest value smaller than the target. If the current root is smaller than the target, it is a possible predecessor, so I save it and move right to look for a larger valid value. If the current root is greater than or equal to the target, I move left."