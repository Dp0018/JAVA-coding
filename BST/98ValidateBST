class Solution {
    public boolean isValidBST(TreeNode root) {
        return validate(root, Long.MIN_VALUE, Long.MAX_VALUE);
    }

    private boolean validate(TreeNode root, long min, long max) {

        // Empty tree is a valid BST
        if (root == null) {
            return true;
        }

        // Current node must be within the allowed range
        if (root.val <= min || root.val >= max) {
            return false;
        }

        // Left subtree: values must be between min and root.val
        if (!validate(root.left, min, root.val)) {
            return false;
        }

        // Right subtree: values must be between root.val and max
        if (!validate(root.right, root.val, max)) {
            return false;
        }

        return true;
    }
}

//I validate the BST using a minimum and maximum allowed range for every node.
//  Initially, the range is negative infinity to positive infinity.
//  For the left subtree, the maximum becomes the current node's value, and for the right subtree, the minimum becomes the current node's value. 
// If any node falls outside its allowed range, the tree is not a valid BST."

//Time: O(n) where n is the number of nodes in the tree
//Space: O(h) where h is the height of the tree due to recursion stack