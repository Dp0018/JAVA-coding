class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

class LinkedList {

    Node head;


    void nthNodeFromEnd(int n) {
        if (head == null) {
            System.out.println("The linked list is empty.");
            return;
        }

        Node fast = head;
        Node slow = head;

        // Move the fast pointer n nodes ahead
        for (int i = 0; i < n; i++) {
            if (fast == null) {
                System.out.println("The linked list has fewer than " + n + " nodes.");
                return;
            }
            fast = fast.next;
        }

        // Move both pointers until the fast pointer reaches the end
        while (fast != null) {
            fast = fast.next;
            slow = slow.next;
        }

        System.out.println("The " + n + "th node from the end is: " + slow.data);
    }

}
// Example usage:
public class Main {
    public static void main(String[] args) {
        LinkedList list = new LinkedList();
        list.head = new Node(1);
        list.head.next = new Node(2);
        list.head.next.next = new Node(3);      
        list.nthNodeFromEnd(2); // Output: The 2nd node from the end is: 2
    }
}
//this code defines a simple linked list and a method to find the nth node from the end of the list. The `nthNodeFromEnd` method uses two pointers (fast and slow) to traverse the list. The fast pointer is moved n nodes ahead first, and then both pointers are moved together until the fast pointer reaches the end of the list. At that point, the slow pointer will be at the nth node from the end. 
//the example usage creates a linked list with three nodes and calls the `nthNodeFromEnd` method to find the 2nd node from the end, which is 2.